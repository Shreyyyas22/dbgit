# API Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Meta Database
META_DATABASE_URL=postgresql+asyncpg://dbgit:dbgit_password@postgres-meta:5432/dbgit_meta

# Target Database (for testing)
TARGET_DATABASE_URL=postgresql+asyncpg://target_user:target_password@postgres-target:5432/target_db

# Redis Cache
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Auth
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
